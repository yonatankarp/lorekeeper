{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lorekeeper",
  "version": "0.1.0",
  "identifier": "com.yonatankarp.dndnotes",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lorekeeper",
        "url": "index.html",
        "width": 1120,
        "height": 740,
        "visible": false,
        "minWidth": 720,
        "minHeight": 480,
        "zoomHotkeysEnabled": true
      },
      {
        "label": "capture",
        "title": "Quick Note",
        "url": "capture.html",
        "width": 640,
        "height": 60,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}