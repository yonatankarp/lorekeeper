{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lorekeeper",
  "version": "0.8.0",
  "identifier": "com.yonatankarp.dndnotes",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Lorekeeper",
        "url": "index.html",
        "width": 1120,
        "height": 740,
        "visible": false,
        "minWidth": 720,
        "minHeight": 480,
        "zoomHotkeysEnabled": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 26
        }
      },
      {
        "label": "capture",
        "create": false,
        "title": "Quick Note",
        "url": "capture.html",
        "width": 640,
        "height": 60,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "settings",
        "create": false,
        "title": "Lorekeeper Settings",
        "url": "settings.html",
        "width": 560,
        "height": 600,
        "visible": false,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["lorekeeper"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0NzZEMjVFNDE0ODQzQUEKUldTcVEwaEJYdEoyVkRuNld4UXlKL3dHN3Arc250Z3l6Mmw0UjIyK2s0SlNuUktIbmZhMklkSDQK",
      "endpoints": [
        "https://github.com/yonatankarp/lorekeeper/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "Lorekeeper"
}
